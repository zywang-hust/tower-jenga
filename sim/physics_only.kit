[package]
title = "Jenga physics only"
description = "PhysX and USD without any Hydra renderer: the H800 cannot start the RTX ray-tracing pipeline"
version = "1.0.0"

[dependencies]
"omni.usd" = {}
"omni.kit.usd.layers" = {}
"omni.physx" = {}
"omni.physx.tensors" = {}
"isaacsim.core.api" = {}
"omni.kit.loop-isaac" = {}

[settings.app]
name = "Jenga-Physics"
version = "1.0.0"
settings.persistent = false
renderer.skipWhileMinimized = true
content.emptyStageOnStart = true

# PhysX steps in the calling thread. Its dispatcher fans out to the carb.tasking and TBB pools (32 threads each by
# default), which spin while a step runs: 31 cores per worker at 2.1 ms per tick, against 1.3 cores at 1.5 ms with
# this and limit_cpu_threads=2 (sim/physics_worker.py); states bit-identical over 3480 ticks
[settings.persistent.physics]
numThreads = 0

[settings.app.exts.folders]
'++' = [
    "${kit}/../exts",
    "${kit}/../extscache",
    "${kit}/../extsDeprecated",
]
