 import openpi.training.weight_loaders as _weight_loaders
 
 
+# Gradient accumulation: the global batch is processed as this many equal microbatches per optimizer step.
+GRAD_ACCUM_STEPS = 1
+
+
 def init_logging():
     """Custom logging format for better readability."""
     level_mapping = {"DEBUG": "D", "INFO": "I", "WARNING": "W", "ERROR": "E", "CRITICAL": "C"}
@@ -155,7 +159,24 @@ def train_step(
 
     # Filter out frozen params.
     diff_state = nnx.DiffState(0, config.trainable_filter)
-    loss, grads = nnx.value_and_grad(loss_fn, argnums=diff_state)(model, train_rng, observation, actions)
+    if GRAD_ACCUM_STEPS == 1:
+        loss, grads = nnx.value_and_grad(loss_fn, argnums=diff_state)(model, train_rng, observation, actions)
+    else:
+        # Equal-size microbatches, so the mean of microbatch losses/grads is the full-batch mean. Rows are taken
+        # interleaved (every n-th) so each microbatch stays evenly spread over the data-parallel devices. Each
+        # microbatch draws its own flow-matching noise/time via fold_in (statistically, not bitwise, equivalent).
+        n = GRAD_ACCUM_STEPS
+        loss, grads = 0.0, None
+        for i in range(n):
+            micro = jax.tree.map(lambda x, i=i: x.reshape(x.shape[0] // n, n, *x.shape[1:])[:, i], (observation, actions))
+            micro = sharding.activation_sharding_constraint(micro)
+            micro_loss, micro_grads = nnx.value_and_grad(loss_fn, argnums=diff_state)(
+                model, jax.random.fold_in(train_rng, i), *micro
+            )
+            loss = loss + micro_loss / n
+            grads = jax.tree.map(lambda g: g / n, micro_grads) if grads is None else jax.tree.map(
+                lambda acc, g: acc + g / n, grads, micro_grads
+            )
 
     params = state.params.filter(config.trainable_filter)
     updates, new_opt_state = state.tx.update(grads, state.opt_state, params)
